html
  head
    title Detalle del Producto
    style.
      body {
        font-family: Arial, sans-serif;
        margin: 20px;
        background-color: #f4f4f4;
      }
      .card {
        background: white;
        padding: 20px;
        border-radius: 5px;
        max-width: 400px;
      }
      a {
        display: inline-block;
        margin-top: 15px;
        text-decoration: none;
        color: #0066cc;
      }

  body
    h1 Detalle del Producto
    
    .card
      h2 #{producto.nombre}
      p 
        strong Precio: 
        | $#{producto.precio}
      p 
        strong Stock disponible: 
        | #{producto.stock} unidades
        
    a(href="/productos") ← Volver a la lista de productos