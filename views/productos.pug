html
  head
    title Gestión de Productos | Todo Stock
    style.
      :root {
        --primary: #10b981;
        --primary-hover: #059669;
        --bg-color: #f8fafc;
        --card-bg: #ffffff;
        --text-main: #1e293b;
        --text-muted: #64748b;
      }
      body {
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        margin: 0;
        padding: 30px;
        background-color: var(--bg-color);
        color: var(--text-main);
      }
      .header-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        padding-bottom: 20px;
        border-bottom: 2px solid #e2e8f0;
      }
      h1 { margin: 0; font-size: 28px; color: #0f172a; }
      
      /* BOTÓN DE NAVEGACIÓN PRINCIPAL */
      .btn-nav {
        background-color: var(--primary);
        color: white;
        padding: 10px 24px;
        border-radius: 50px;
        text-decoration: none;
        font-weight: 600;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        transition: all 0.3s ease;
      }
      .btn-nav:hover {
        background-color: var(--primary-hover);
        transform: translateY(-2px);
      }

      /* GRILLA DE TARJETAS */
      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 20px;
      }
      .card {
        background: var(--card-bg);
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
        border: 1px solid #e2e8f0;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }
      .card-title { font-size: 20px; font-weight: bold; margin: 0 0 10px 0; }
      .card-price { font-size: 24px; color: var(--primary); font-weight: bold; margin: 0 0 5px 0; }
      .card-stock { color: var(--text-muted); font-size: 14px; margin-bottom: 20px; }
      
      /* BOTONES DE ACCIÓN */
      .actions {
        display: flex;
        gap: 10px;
        margin-top: 15px;
        flex-wrap: wrap;
      }
      .btn {
        padding: 8px 16px;
        border-radius: 6px;
        text-decoration: none;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        border: none;
        text-align: center;
        flex: 1;
        transition: opacity 0.2s;
      }
      .btn:hover { opacity: 0.8; }
      .btn-view { background-color: #f1f5f9; color: #334155; border: 1px solid #cbd5e1; }
      .btn-edit { background-color: #f59e0b; color: white; }
      .btn-delete { background-color: #ef4444; color: white; }

  body
    .header-container
      h1 📦 Gestión de Productos
      a.btn-nav(href="/pedidos") 📋 Ir a Pedidos

    if productos.length > 0
      .grid
        each producto in productos
          .card
            div
              h3.card-title #{producto.nombre}
              p.card-price $#{producto.precio}
              p.card-stock Unidades en stock: #{producto.stock}
            
            .actions
              a.btn.btn-view(href=`/productos/${producto._id}`) Ver Detalle
              
              //- LÓGICA DE ROLES: Solo visible para Admin
              if usuario && usuario.role === 'admin'
                button.btn.btn-edit Editar
                button.btn.btn-delete Eliminar
    else
      p(style="text-align: center; color: #64748b; font-size: 18px; margin-top: 50px;") No hay productos registrados en el sistema.

    //- Contenedor invisible donde aparecerán las notificaciones flotantes
    #toast-container(style="position: fixed; top: 20px; right: 20px; z-index: 9999;")

    //- Importamos el cliente oficial de Socket.io
    script(src="/socket.io/socket.io.js")

    script.
      const socket = io();
      socket.on('alerta-stock', (data) => {
        
        // Elemento visual de la notificación flotante
        const toast = document.createElement('div');
        toast.style.background = '#ff4444'; // Fondo rojo para alertas
        toast.style.color = 'white';
        toast.style.padding = '15px 25px';
        toast.style.marginBottom = '10px';
        toast.style.borderRadius = '5px';
        toast.style.boxShadow = '0 4px 6px rgba(0,0,0,0.1)';
        toast.style.transition = 'opacity 0.5s ease';
        
        // Mensaje que viene del backend
        toast.innerText = data.mensaje;

        // Lo agregamos al contenedor
        const container = document.getElementById('toast-container');
        container.appendChild(toast);

        // Hacemos que desaparezca solo después de 4 segundos
        setTimeout(() => {
          toast.style.opacity = '0';
          setTimeout(() => toast.remove(), 500); // Lo borramos del HTML tras desvanecerse
        }, 4000);
      });