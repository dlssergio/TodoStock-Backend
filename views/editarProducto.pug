html
  head
    title Editar Producto | Todo Stock
    style.
      :root { --primary: #f59e0b; --primary-hover: #d97706; --bg-color: #f8fafc; --card-bg: #ffffff; --text-main: #1e293b; }
      body { font-family: 'Segoe UI', system-ui, sans-serif; margin: 0; padding: 40px 20px; background-color: var(--bg-color); color: var(--text-main); display: flex; justify-content: center; }
      .form-container { width: 100%; max-width: 500px; }
      .card { background: var(--card-bg); border-radius: 12px; padding: 40px; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1); border: 1px solid #e2e8f0; }
      h1 { margin: 0 0 25px 0; font-size: 28px; color: #0f172a; border-bottom: 2px solid #e2e8f0; padding-bottom: 15px;}
      .form-group { margin-bottom: 20px; }
      label { display: block; margin-bottom: 8px; font-weight: bold; color: #334155; }
      input { width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 16px; box-sizing: border-box; }
      .btn-submit { background: var(--primary); color: white; padding: 12px 24px; border: none; border-radius: 6px; font-size: 16px; font-weight: bold; cursor: pointer; width: 100%; transition: background 0.3s; margin-top: 10px; }
      .btn-submit:hover { background: var(--primary-hover); }
      .btn-cancel { display: block; text-align: center; margin-top: 15px; color: #64748b; text-decoration: none; font-weight: 500; }

  body
    .form-container
      .card
        h1 ✏️ Editar Producto
        
        form(action=`/productos/editar/${producto._id}` method="POST")
          .form-group
            label(for="nombre") Nombre del Producto:
            //- El atributo "value" carga los datos actuales de la base de datos
            input(type="text" name="nombre" id="nombre" required value=producto.nombre)
            
          .form-group
            label(for="precio") Precio (en pesos):
            input(type="number" name="precio" id="precio" required min="0" step="0.01" value=producto.precio)
            
          .form-group
            label(for="stock") Stock Disponible:
            input(type="number" name="stock" id="stock" required min="0" value=producto.stock)
                
          button.btn-submit(type="submit") Actualizar Producto
          a.btn-cancel(href="/productos") Cancelar