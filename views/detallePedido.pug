html
  head
    title Detalle del Pedido | Todo Stock
    style.
      :root {
        --primary: #2563eb;
        --bg-color: #f8fafc;
        --card-bg: #ffffff;
        --text-main: #1e293b;
        --text-muted: #64748b;
      }
      body {
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        margin: 0;
        padding: 40px 20px;
        background-color: var(--bg-color);
        color: var(--text-main);
        display: flex;
        justify-content: center;
      }
      .detail-container {
        width: 100%;
        max-width: 700px;
      }
      .header-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
        border-bottom: 2px solid #e2e8f0;
        padding-bottom: 15px;
      }
      h1 { margin: 0; font-size: 28px; color: #0f172a; }
      
      .status-badge {
        background-color: #fef3c7;
        color: #d97706;
        padding: 6px 14px;
        border-radius: 20px;
        font-weight: bold;
        font-size: 14px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }
      
      .card {
        background: var(--card-bg);
        border-radius: 12px;
        padding: 40px;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
        border: 1px solid #e2e8f0;
      }
      .client-name { font-size: 26px; font-weight: bold; margin: 0 0 30px 0; color: #0f172a; display: flex; align-items: center; }
      .client-name::before { content: '👤'; margin-right: 12px; }
      
      .section-title { font-size: 18px; color: var(--text-muted); margin: 0 0 15px 0; border-bottom: 1px solid #e2e8f0; padding-bottom: 8px; }
      
      .items-list {
        list-style: none;
        padding: 0;
        margin: 0 0 30px 0;
      }
      .item-row {
        display: flex;
        justify-content: space-between;
        padding: 14px 0;
        border-bottom: 1px dashed #cbd5e1;
        font-size: 16px;
      }
      .item-row:last-child { border-bottom: none; }
      
      .total-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #f1f5f9;
        padding: 25px;
        border-radius: 8px;
        margin-top: 10px;
      }
      .total-label { font-size: 18px; font-weight: 600; color: #334155; margin: 0; }
      .total-value { font-size: 32px; font-weight: bold; color: var(--primary); margin: 0; }
      
      .btn-back {
        display: inline-flex;
        align-items: center;
        margin-top: 30px;
        color: #475569;
        text-decoration: none;
        font-weight: 600;
        transition: color 0.2s;
      }
      .btn-back:hover { color: #0f172a; }
      .btn-back::before { content: '←'; margin-right: 8px; font-size: 20px; }

  body
    .detail-container
      .header-container
        h1 📄 Información del Pedido
        span.status-badge #{pedido.estado}
      
      .card
        h2.client-name Cliente: #{pedido.cliente}
        
        h3.section-title Artículos Comprados
        if pedido.productos.length > 0
          ul.items-list
            each producto in pedido.productos
              li.item-row
                span #{producto.nombre}
                span(style="font-weight: 600;") $#{producto.precio}
        else
          p(style="color: #64748b; font-style: italic;") No hay productos registrados en este pedido.
          
        .total-container
          span.total-label Total a Pagar
          span.total-value $#{pedido.total}
          
      a.btn-back(href="/pedidos") Volver a la Géstion de Pedidos